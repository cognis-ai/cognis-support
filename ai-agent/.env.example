# Cognis Chat AI sidecar — V0 config. Copy to .env (gitignored).

# --- Cognis Brain gateway (the LLM source — NOT DeepSeek-direct) ---
BRAIN_BASE_URL=http://localhost:8100/v1
BRAIN_MODEL=cognis-brain-default
# Admin token to MINT per-org keys via Brain POST /admin/keys (dev default in cognis-brain compose).
# Only needed by scripts/mint-key.ts; the sidecar itself uses each tenant's own cbk_live_ key.
BRAIN_ADMIN_TOKEN=dev-admin-token

# --- Chatwoot shell ---
CHATWOOT_BASE_URL=http://localhost:3000

# --- Sidecar ---
PORT=4100
# Per-tenant config (account_id -> org_id + Chatwoot tokens + per-org Brain key).
# V0 store = JSON file (Postgres-ready interface). Seed from .env.example -> tenants.json.
TENANTS_FILE=./tenants.json
# Own audit store — append-only JSONL (org-stamped, prompt-versioned).
AUDIT_FILE=./audit/agent-bot.jsonl
MAX_HISTORY_MESSAGES=12
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# --- RAG / knowledge grounding (V2) — reuse the Brain's shared embeddings ---
BRAIN_EMBED_MODEL=cognis-embed
KB_FILE=./kb/kb.json
RAG_TOP_K=4
# bge-small cosine: relevant ~0.6-0.9, same-domain noise floors ~0.45. 0.5 separates them.
RAG_MIN_SCORE=0.5

# --- V3 hardening ---
# Verify Chatwoot's X-Chatwoot-Signature HMAC (per-tenant agent-bot secret). Set true in prod.
WEBHOOK_AUTH_ENFORCE=false
# Per-IP requests/min on the webhook endpoint (0 = disabled).
WEBHOOK_RPM=120
